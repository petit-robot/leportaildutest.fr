---
import PureGrid from "../../components/directory/PureGrid.astro";
import { getCollection } from "astro:content";
import formatString from "../../util/formatString";
import type Tag from "../../types/Tag";
import config from "@util/themeConfig";
import Sidebar from "@layouts/Sidebar.astro";
import { sortListings } from "@lib/getListings";

export async function getStaticPaths() {
  const tags: Array<Tag> = config.directoryData.tags;

  const result = tags.map((e) => ({
    params: { slug: e.key },
    props: { color: e.color, title: e.key },
  }));

  return result;
}

const { title } = Astro.props;

const allListings = await getCollection("directory");

const tag = config.directoryData.tags.find(
  (e: Tag) => title && e.key === title,
);

const calculatedTitle = tag?.name;
const calculatedDescription = tag?.description;
const tagListings: any[] = allListings.filter((listing: any) => {
  return (
    listing?.data?.tags instanceof Array && listing.data.tags.includes(title)
  );
});

// A tag with subtags lists its resources under one heading per subtag, then the resources without one.
const subtags = tag?.subtags ?? [];
const sortedListings = sortListings(tagListings);
const subtagGroups = subtags
  .map((subtag) => ({
    name: subtag.name,
    listings: sortedListings.filter((listing) => listing.data.subtag === subtag.key),
  }))
  .filter((group) => group.listings.length > 0);
const listingsWithoutSubtag = sortedListings.filter(
  (listing) => !subtags.some((subtag) => subtag.key === listing.data.subtag),
);

function toTitleCase(str: string) {
  return str.replace(
    /\w\S*/g,
    (text) => text.charAt(0).toUpperCase() + text.substring(1).toLowerCase(),
  );
}
---

<Sidebar>
  <div class="max-w-3xl xl:max-w-6xl w-full mx-auto">
    <h1 class="text-gray-600 font-semibold text-4xl">
      {
        toTitleCase(
          formatString(config.directoryData.tagPages.title, calculatedTitle),
        )
      }
    </h1>
    <p class="text-gray-600 dark:text-gray-200 mb-12 max-w-prose">
      {calculatedDescription}
    </p>
    {
      subtags.length === 0 ? (
        <PureGrid listings={sortedListings} />
      ) : (
        <>
          {subtagGroups.map((group) => (
            <section class="mb-12">
              <h2 class="text-gray-600 dark:text-gray-200 font-semibold text-2xl mb-4">
                {group.name}
              </h2>
              <PureGrid listings={group.listings} />
            </section>
          ))}
          {listingsWithoutSubtag.length > 0 && (
            <PureGrid listings={listingsWithoutSubtag} />
          )}
        </>
      )
    }
  </div>
</Sidebar>
