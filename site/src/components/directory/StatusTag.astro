---
import configData from "@util/themeConfig";
import { isDimmedStatus } from "@lib/status";

const { status, class: className = "absolute right-4 -bottom-3" } = Astro.props;

const label = isDimmedStatus(status)
  ? configData.directoryUI.status[status]?.labelForCard
  : undefined;
---

{
  label ? (
    <span
      class:list={[
        "text-sm font-medium py-0.5 group-hover:border-primary-500 border border-gray-300 rounded-full bg-white px-3.5 text-gray-600 dark:bg-gray-800 dark:border-gray-500 dark:text-white",
        className,
      ]}
    >
      {label}
    </span>
  ) : (
    <></>
  )
}
