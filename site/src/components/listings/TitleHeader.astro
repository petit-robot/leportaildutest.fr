---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import StatusTag from "@components/directory/StatusTag.astro";
import PaidTag from "@components/directory/PaidTag.astro";

const { title, link, linkText, description, image, status, paid } = Astro.props;
---

<div class="mb-10">
  <div class="flex justify-between items-end">
    <div>
      {image && <Image class="h-15 w-15 mb-8 object-contain" src={image} alt={title} />}
      <div class="flex items-center gap-3 flex-wrap">
        <h1 class="font-bold text-4xl text-gray-900 dark:text-gray-50">
          {title}
        </h1>
        {paid && <PaidTag class="" />}
        <StatusTag status={status} class="" />
      </div>
    </div>
    {
      link && (
        <a
          class="inline-flex items-center gap-1 font-medium text-gray-800 dark:text-gray-100"
          href={link}
        >
          {linkText}
          <Icon name="tabler:arrow-up-right" />
        </a>
      )
    }
  </div>
  <p class="text-gray-400 mt-2.5">{description}</p>
</div>