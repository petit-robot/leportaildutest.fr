---
import AppLogo from "./Logo.astro";
import { Icon } from "astro-icon/components";
import config from "@util/themeConfig";

const socials = Object.values(config.footer.socials);
const socialNames = Object.keys(config.footer.socials);

const navigation = [
  {
    title: "Categories",
    links: config.directoryData.tags
      ?.filter((e) => e && e.name)
      .map((e) => ({
        title: e.name,
        link: `/tags/${e.key}`,
      }))
      .slice(0, 10),
  },
  {
    title: "Ressources",
    links: [
      {
        title: "Proposer une ressource",
        link: "https://github.com/petit-robot/leportaildutest.fr/issues/new?template=ressource-ajout.yml",
        external: true,
      },
      {
        title: "Proposer une modification",
        link: "https://github.com/petit-robot/leportaildutest.fr/issues/new?template=ressource-modification.yml",
        external: true,
      },
    ],
  },
  // {
  //   title: "Blog",
  //   links: [{ title: "Articles", link: "/blog" }],
  // },
  {
    title: "Legal",
    links: [
      { title: "Mentions légales", link: "/legal/mentions" },
    ],
  },
];
---

<footer
  class="border-t border-gray-200 dark:border-gray-600 font-display"
  aria-labelledby="footer-heading"
>
  <h2 id="footer-heading" class="sr-only">Footer</h2>
  <div class="mx-auto max-w-7xl px-6 pb-8 pt-16 sm:pt-24 lg:px-8 lg:pt-32">
    <div class="xl:grid xl:grid-cols-3 xl:gap-8">
      <div class="space-y-8">
        <AppLogo />
        <div class="flex space-x-6">
          {
            socials.map((item, index) => (
              <a href={item?.link} class="text-gray-400 hover:text-gray-500">
                <span class="sr-only">{item}</span>
                <Icon
                  name={
                    config.ui.icons[
                      socialNames[index] as keyof typeof config.ui.icons
                    ]
                  }
                  class="h-6 w-6"
                  aria-hidden="true"
                />
              </a>
            ))
          }
        </div>
      </div>
      <div class="mt-16 grid grid-cols-2 gap-8 xl:col-span-2 xl:mt-0">
        {
          [...Array(2).keys()].map((count) => (
            <div class="md:grid md:grid-cols-2 md:gap-8">
              <div>
                <h3 class="text-sm font-semibold text-gray-400 tracking-wider uppercase">
                  {navigation[count].title}
                </h3>
                <ul role="list" class="mt-6 space-y-4">
                  {navigation[count].links.map((item) => (
                    <li>
                      <a
                        href={item.link}
                        target={"external" in item && item.external ? "_blank" : undefined}
                        rel={"external" in item && item.external ? "noopener noreferrer" : undefined}
                        class="text-sm leading-6 text-gray-600 dark:text-gray-300 hover:dark:text-gray-400 hover:text-gray-900"
                      >
                        {item.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>

              {navigation[count + 2] && (
                <div class="mt-10 md:mt-0">
                  <h3 class="text-sm font-semibold text-gray-400 tracking-wider uppercase">
                    {navigation[count + 2].title}
                  </h3>
                  <ul role="list" class="mt-6 space-y-4">
                    {navigation[count + 2].links.map((item) => (
                      <li>
                        <a
                          href={item.link}
                          target={"external" in item && item.external ? "_blank" : undefined}
                          rel={"external" in item && item.external ? "noopener noreferrer" : undefined}
                          class="text-sm leading-6 text-gray-600 dark:text-gray-300 hover:dark:text-gray-400 hover:text-gray-900"
                        >
                          {item.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          ))
        }
      </div>
    </div>
    <div
      class="mt-16 border-t border-gray-900/10 dark:border-gray-600 pt-8 sm:mt-20 lg:mt-24"
    >
      <p class="mt-2 text-xs leading-5 text-gray-500">
        Le contenu éditorial est publié sous licence{" "}
        <a
          href="https://creativecommons.org/licenses/by-sa/4.0/deed.fr"
          target="_blank"
          rel="license noopener noreferrer"
          class="underline hover:text-gray-700 dark:hover:text-gray-300"
        >
          CC BY-SA 4.0
        </a>.
      </p>
    </div>
  </div>
</footer>
