# linkchecker settings for the full crawl of the deployed site

[checking]
threads=10
timeout=30
# Do not hammer a single host.
maxrequestspersecond=5

[filtering]
# Actually call the external links instead of only checking their syntax.
checkextern=1
# Links that are not called at all, because they are known not to answer.
ignore=
  # status: closed
  ^https://allaboutqablog\.com/$
  # Don't respond from Github
  ^https://www\.eyrolles\.com/.*$

[output]
# Tolerated errors, as: <url regex> <error message regex>.
# For hosts that protect themselves against robots: the link is alive but
# answers an error to anything that is not a browser.
ignoreerrors=
  ^https://medium\.com/ ^403
